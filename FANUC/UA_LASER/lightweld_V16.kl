PROGRAM lightweld
%COMMENT = 'LightWELD flag drv'
%NOLOCKGROUP
%NOBUSYLAMP
%NOPAUSESHFT
%NOPAUSE = ERROR + COMMAND + TPENABLE
%NOABORT = ERROR + COMMAND
%ENVIRONMENT FLBT
%ENVIRONMENT REGOPE
%ENVIRONMENT IOSETUP
%SYSTEM 
%INCLUDE kliotyps

-- ============================================================
-- IPG LightWELD 1500 - TCP driver, controlled by FLAGS F[]
--
-- Flags are read / written directly with GET_PORT_VAL / SET_PORT_VAL
-- and port type io_flag (= 35, defined in KLIOTYPS.KL).
-- No I/O assignment is needed. Each call returns a status, so a
-- wrong flag number is reported on the TP instead of stopping the task.
--
-- BACKGROUND TASK: start it ONCE with  RUN LIGHTWELD  (not CALL).
--   * connects to the laser automatically, reconnects after a failure
--   * keeps running when SHIFT is released, when the TP is enabled,
--     on robot errors and on ABORT ALL / pause commands
--   * stop:  R[35] = 1   (disconnects cleanly)
--            or  KCL> ABORT LIGHTWELD FORCE
--     Set R[35] = 0 before starting.
--
-- Flags IN  (ArcTool -> laser), lowest flag number = LSB
--   F[705]      Trigger 1        mirrored to a DO, see trigger mirror
--   F[706]      Trigger 2        mirrored to a DO, see trigger mirror
--   F[707]      Nozzle           prepared only, NOT used
--   F[708]      Error Reset      rising edge 0 -> 1 sends RERR to the laser
--   F[713-715]  Process Select   -> SMAT 0 (even value, Steel)
--                                   SMAT 1 (odd value,  Aluminum)
--   F[721-736]  Laser Power      -> SPOW  <W>
--   F[737-752]  Wobble frequency -> SWFREQ <Hz>
--   F[753-768]  Wobble width     -> SWLEN <mm>
--   F[769-784]  Compensation     -> SPCF  <%>      (power compensation factor)
--   A value is sent when it changed and has been stable for 2 scans.
--   Laser program: always USER program X, index 0 ("SPROG X 0").
--   SPROG is sent first after every (re)connect, then all values.
--   Every poll RPROG is checked; if the laser runs another program or
--   index (front panel, preset), SPROG and all values are sent again.
--   A refused SPROG is retried every sprog_retry_ms.
--
-- Fixed laser parameters (CONST, checked one per cycle, sent again
-- when the value read back from the laser differs):
--   SPREF 0.1 s, SPOSTF 0.1 s  (sent with save = 1 -> non-volatile)
--   SRMPU 1 ms,  SRMPD 1 ms    (index settings, no save argument)
--
-- Flags OUT (laser -> ArcTool)
--   F[865]      IPG No Error     INVERTED: 1 = OK,
--                                0 = STA alarm active or no connection
--   F[866]      Emission ON      STG bit 2
--   F[868]      Purge gas ON     RPURGE (1 = purge gas enabled), 0 = no connection
--   F[867]      Process Active   NOT written - no source in the TCP interface
--   F[881-896]  Power            RPOW
--   F[897-912]  Wobble frequency RWFREQ
--   F[913-928]  Wobble width     RWLEN
--   F[929-944]  Error code       0        = no alarm, no warning
--                                1..31    = first active STA alarm bit
--                                100..107 = no alarm, first active STW
--                                           warning bit + 100
--                                200      = no connection to the laser
--
-- Trigger mirror (flag -> DO, independent of the laser connection)
--   DO[691] = Trigger 1  <- F[705]
--   DO[692] = Trigger 2  <- F[706]
--   Updated every main loop, before every laser command and every
--   20 ms while waiting for a laser reply. Both DO are switched OFF
--   when the driver stops (R[35] = 1).
--
-- Scaling: basic 1:1 for now, change the *_scale constants below.
--   laser value = flag value * scale,   flag value = laser value / scale
--
-- Controller setup: SETUP > Host Comm > TCP/IP > Clients
--   tag C3, protocol SM, server 10.0.0.20, then START
--   $HOSTC_CFG[3].$SERVER_PORT = 10001  (MENU > SYSTEM > Variables)
-- ============================================================

CONST
  -- stop register
  reg_stop     = 35

  -- timing
  poll_ms      = 50       -- main loop period [ms]
  reconnect_ms = 2000     -- wait between connection attempts [ms]

  -- optional PING before every connection attempt (A.14.10 MSG_PING).
  -- Needs an entry for the laser in SETUP > Host Comm > TCP/IP > Host Name
  -- table: name IPG -> 10.0.0.20. Then set use_ping = TRUE.
  use_ping     = FALSE
  sprog_retry_ms = 5000   -- wait before repeating a refused SPROG [ms]

  -- laser program: always USER program X with this index
  prog_index   = 0

  -- flags are accessed with port type io_flag (KLIOTYPS.KL, value 35)

  -- flags IN (ArcTool -> laser)
  fi_trig1     = 705
  fi_trig2     = 706
  fi_nozzle    = 707      -- prepared, not used
  fi_reset     = 708      -- error reset, rising edge -> RERR
  fi_psel      = 713      -- 3 bits, even -> SMAT 0, odd -> SMAT 1
  fi_power     = 721      -- 16 bits
  fi_wfreq     = 737      -- 16 bits
  fi_wlen      = 753      -- 16 bits
  fi_comp      = 769      -- 16 bits

  -- flags OUT (laser -> ArcTool)
  fo_error     = 865      -- inverted: 1 = OK, 0 = alarm / no connection
  fo_emission  = 866
  fo_pactive   = 867      -- reserved, not written
  fo_power     = 881      -- 16 bits
  fo_wfreq     = 897      -- 16 bits
  fo_wlen      = 913      -- 16 bits
  fo_errcode   = 929      -- 16 bits
  fo_purge     = 868      -- RPURGE: 1 = purge gas enabled

  -- trigger mirror: source flag -> DO (signal table, column M)
  do_trig1     = 691      -- DO[691] = Trigger 1
  trig1_src    = 705      --   from F[705]
  do_trig2     = 692      -- DO[692] = Trigger 2
  trig2_src    = 706      --   from F[706]

  -- scaling (basic 1:1, adjust later)
  power_scale  = 1.0      -- W  per bit
  wfreq_scale  = 1.0      -- Hz per bit
  wlen_scale   = 0.1      -- mm per bit
  comp_scale   = 1.0      -- %  per bit

  -- fixed laser parameters, kept by check_const (read back cyclically,
  -- sent again when the laser value differs)
  pref_s       = 0.1      -- SPREF  gas pre-flow  [s]   (IPG 2.25, sent with save = 1)
  postf_s      = 0.1      -- SPOSTF gas post-flow [s]   (IPG 2.27, sent with save = 1)
  rmpu_ms      = 1        -- SRMPU  ramp up       [ms]  (IPG 2.43, USER program)
  rmpd_ms      = 1        -- SRMPD  ramp down     [ms]  (IPG 2.45, USER program)
  n_cst        = 4        -- number of fixed parameters
  cst_tol      = 0.0005   -- tolerance for the REAL compare [s]
  cst_retry_ms = 5000     -- wait before repeating a refused SET [ms]

  -- error code written when there is no connection to the laser
  err_no_conn  = 200      -- 100..107 are used by the STW warnings
  warn_ofs     = 100      -- error code = STW bit + warn_ofs

  -- input channels
  in_mat       = 1        -- Process Select parity -> SMAT
  in_power     = 2
  in_wfreq     = 3
  in_wlen      = 4
  in_comp      = 5
  n_in         = 5

  -- output channels (index into out_last)
  out_error    = 1
  out_emis     = 2
  out_errcode  = 3
  out_power    = 4
  out_wfreq    = 5
  out_wlen     = 6
  out_purge    = 7
  n_out        = 7

VAR
  socket_file   : FILE
  client_tag    : STRING[4]
  connected     : BOOLEAN
  file_open     : BOOLEAN
  stop_req      : BOOLEAN
  detail_code   : INTEGER
  last_cmd      : STRING[60]               -- last command sent (for error messages)
  last_reply    : STRING[120]              -- last reply received (for error messages)
  karel_stat    : INTEGER
  laser_host    : STRING[16]               -- host name for MSG_PING
  sys_ready     : BOOLEAN                  -- $PWRUP_DELAY.$SY_READY was TRUE
  sys_rdy_val   : BOOLEAN                  -- value read by GET_VAR
  sys_rdy_entry : INTEGER                  -- GET_VAR entry (do not modify)
  sys_rdy_err   : BOOLEAN                  -- GET_VAR error already reported
  no_conn_shown : BOOLEAN                  -- "no connection" already reported
  retry_count   : INTEGER

  in_port       : ARRAY[n_in] OF INTEGER
  in_bits       : ARRAY[n_in] OF INTEGER
  in_prev       : ARRAY[n_in] OF INTEGER   -- value read in the previous scan
  in_sent       : ARRAY[n_in] OF INTEGER   -- value last sent, -1 = must send
  in_err_shown  : ARRAY[n_in] OF BOOLEAN

  out_last      : ARRAY[n_out] OF INTEGER  -- value last written, -1 = unknown
  out_err_shown : ARRAY[n_out] OF BOOLEAN

  sta_bad_shown : BOOLEAN                  -- non-numeric STA reply already reported
  rst_last      : INTEGER                  -- last state of the reset flag, -1 = unknown
  sprog_ok      : BOOLEAN                  -- SPROG X <prog_index> accepted
  sprog_retry   : INTEGER                  -- cycles until the next SPROG attempt

  -- trigger mirror (index 1 = Trigger 1, 2 = Trigger 2)
  trig_src      : ARRAY[2] OF INTEGER      -- source flag number
  trig_do       : ARRAY[2] OF INTEGER      -- target DO number
  trig_last     : ARRAY[2] OF INTEGER      -- last value written, -1 = unknown
  trig_err      : ARRAY[2] OF BOOLEAN      -- error already reported

  init_idx      : INTEGER

  -- fixed parameters (check_const)
  cst_idx       : INTEGER                  -- parameter checked in this cycle
  cst_wait      : ARRAY[n_cst] OF INTEGER  -- checks to skip after a refused SET
  cst_err_shown : ARRAY[n_cst] OF BOOLEAN  -- refused SET already reported


-- ------------------------------------------------------------
-- Integer -> string (decimal)
-- ------------------------------------------------------------
ROUTINE int_str(number : INTEGER; out_str : STRING)
VAR
  work_val, digit : INTEGER
  is_negative  : BOOLEAN
BEGIN
  out_str = ''
  is_negative = FALSE
  work_val = number
  IF work_val < 0 THEN
    is_negative = TRUE
    work_val = -work_val
  ENDIF
  IF work_val = 0 THEN
    out_str = '0'
  ENDIF
  WHILE work_val > 0 DO
    digit = work_val MOD 10
    out_str = CHR(48 + digit) + out_str
    work_val = work_val DIV 10
  ENDWHILE
  IF is_negative THEN
    out_str = '-' + out_str
  ENDIF
END int_str

-- ------------------------------------------------------------
-- Real -> string with 3 decimals
-- ------------------------------------------------------------
ROUTINE real_str(number : REAL; out_str : STRING)
VAR
  abs_val      : REAL
  int_part, frac_part : INTEGER
  frac_str     : STRING[8]
  is_negative    : BOOLEAN
BEGIN
  is_negative = FALSE
  abs_val = number
  IF abs_val < 0 THEN
    is_negative = TRUE
    abs_val = -abs_val
  ENDIF
  int_part = TRUNC(abs_val)
  frac_part = ROUND((abs_val - int_part) * 1000)
  IF frac_part >= 1000 THEN
    int_part = int_part + 1
    frac_part = frac_part - 1000
  ENDIF
  int_str(int_part, out_str)
  int_str(frac_part, frac_str)
  WHILE STR_LEN(frac_str) < 3 DO
    frac_str = '0' + frac_str
  ENDWHILE
  out_str = out_str + '.' + frac_str
  IF is_negative THEN
    out_str = '-' + out_str
  ENDIF
END real_str

-- ------------------------------------------------------------
-- Write value to n_bits consecutive flags F[first_flag..]
-- (first flag = LSB), port type io_flag.
-- Only writes when the value differs from the last one written.
-- A failing port is reported once on the TP message line.
-- ------------------------------------------------------------
ROUTINE write_group(out_idx : INTEGER; first_flag : INTEGER; n_bits : INTEGER; value : INTEGER)
VAR
  bit_no, work_val, stat : INTEGER
  all_ok : BOOLEAN
BEGIN
  IF value = out_last[out_idx] THEN
    RETURN
  ENDIF
  all_ok = TRUE
  work_val = value
  FOR bit_no = 0 TO n_bits - 1 DO
    SET_PORT_VAL(io_flag, first_flag + bit_no, work_val MOD 2, stat)
    IF stat <> 0 THEN
      all_ok = FALSE
      IF NOT out_err_shown[out_idx] THEN
        WRITE TPERROR('LW: F[', (first_flag + bit_no)::1, '] write status ', stat::1, CR)
        out_err_shown[out_idx] = TRUE
      ENDIF
    ENDIF
    work_val = work_val DIV 2
  ENDFOR
  IF all_ok THEN
    out_last[out_idx] = value
    out_err_shown[out_idx] = FALSE
  ENDIF
END write_group

-- ------------------------------------------------------------
-- Flag state while there is no connection to the laser
-- ------------------------------------------------------------
ROUTINE outputs_disconnected
BEGIN
  write_group(out_error, fo_error, 1, 0)         -- inverted: 0 = not OK
  write_group(out_emis, fo_emission, 1, 0)
  write_group(out_purge, fo_purge, 1, 0)
  write_group(out_errcode, fo_errcode, 16, err_no_conn)
END outputs_disconnected

-- ------------------------------------------------------------
-- Close the socket file (only if open) and disconnect the tag
-- ------------------------------------------------------------
ROUTINE lw_close
VAR
  status : INTEGER
BEGIN
  connected = FALSE                 -- first, in case CLOSE / DISCO take long
  IF file_open THEN
    file_open = FALSE
    CLOSE FILE socket_file
  ENDIF
  MSG_DISCO(client_tag, status)
END lw_close

-- ------------------------------------------------------------
-- Open the socket. Returns 0 = OK, else KAREL status code
-- ------------------------------------------------------------
ROUTINE lw_connect : INTEGER
VAR
  status : INTEGER
BEGIN
  lw_close
  IF use_ping THEN
    MSG_PING(laser_host, status)    -- laser not reachable -> skip MSG_CONNECT
    IF status <> 0 THEN
      RETURN(status)
    ENDIF
  ENDIF
  MSG_CONNECT(client_tag, status)
  IF status <> 0 THEN
    RETURN(status)
  ENDIF
  SET_FILE_ATR(socket_file, ATR_UF)
  SET_FILE_ATR(socket_file, ATR_IA)
  OPEN FILE socket_file ('RW', client_tag)
  status = IO_STATUS(socket_file)
  IF status <> 0 THEN
    MSG_DISCO(client_tag, karel_stat)
    RETURN(status)
  ENDIF
  file_open = TRUE
  RETURN(0)
END lw_connect

-- ------------------------------------------------------------
-- Trigger mirror: copy the trigger flags to their DO.
-- Writes a DO only when the value changed. Called from the main loop,
-- before every laser command and while waiting for a laser reply,
-- so a slow laser answer does not delay the triggers.
-- ------------------------------------------------------------
ROUTINE trig_mirror
VAR
  t_idx, bit_val, stat : INTEGER
BEGIN
  FOR t_idx = 1 TO 2 DO
    GET_PORT_VAL(io_flag, trig_src[t_idx], bit_val, stat)
    IF stat <> 0 THEN
      IF NOT trig_err[t_idx] THEN
        WRITE TPERROR('LW: trig F[', trig_src[t_idx]::1, '] read status ', stat::1, CR)
        trig_err[t_idx] = TRUE
      ENDIF
    ELSE
      IF bit_val <> trig_last[t_idx] THEN
        SET_PORT_VAL(io_dout, trig_do[t_idx], bit_val, stat)
        IF stat <> 0 THEN
          IF NOT trig_err[t_idx] THEN
            WRITE TPERROR('LW: trig DO[', trig_do[t_idx]::1, '] write status ', stat::1, CR)
            trig_err[t_idx] = TRUE
          ENDIF
        ELSE
          trig_last[t_idx] = bit_val
          trig_err[t_idx] = FALSE
        ENDIF
      ENDIF
    ENDIF
  ENDFOR
END trig_mirror

-- ------------------------------------------------------------
-- Switch both trigger DO off (driver stop)
-- ------------------------------------------------------------
ROUTINE trig_off
VAR
  t_idx, stat : INTEGER
BEGIN
  FOR t_idx = 1 TO 2 DO
    SET_PORT_VAL(io_dout, trig_do[t_idx], 0, stat)
    trig_last[t_idx] = -1
  ENDFOR
END trig_off

-- ------------------------------------------------------------
-- Raw send + receive one CR-terminated reply
-- Returns 0 OK, -1 timeout, else I/O status
-- ------------------------------------------------------------
ROUTINE lw_cmd(cmd : STRING; reply : STRING) : INTEGER
VAR
  bytes_avail, status, wait_count : INTEGER
  rx_char        : STRING[1]
  msg       : STRING[200]
  rx_complete      : BOOLEAN
BEGIN
  reply = ''
  trig_mirror                       -- keep triggers up to date

  -- flush stale input
  BYTES_AHEAD(socket_file, bytes_avail, status)
  IF status <> 0 THEN
    RETURN(status)
  ENDIF
  WHILE bytes_avail > 0 DO
    READ socket_file(rx_char::1)
    status = IO_STATUS(socket_file)
    IF status <> 0 THEN
      RETURN(status)
    ENDIF
    bytes_avail = bytes_avail - 1
  ENDWHILE

  msg = cmd + CHR(13)
  WRITE socket_file(msg::STR_LEN(msg))
  status = IO_STATUS(socket_file)
  IF status <> 0 THEN
    RETURN(status)
  ENDIF

  wait_count = 0
  rx_complete = FALSE
  WHILE NOT rx_complete DO
    BYTES_AHEAD(socket_file, bytes_avail, status)
    IF status <> 0 THEN
      RETURN(status)
    ENDIF
    IF bytes_avail = 0 THEN
      DELAY 20
      trig_mirror                   -- keep triggers up to date while waiting
      wait_count = wait_count + 1
      IF wait_count > 100 THEN
        RETURN(-1)
      ENDIF
    ELSE
      READ socket_file(rx_char::1)
      status = IO_STATUS(socket_file)
      IF status <> 0 THEN
        RETURN(status)
      ENDIF
      IF rx_char = CHR(13) THEN
        rx_complete = TRUE
      ELSE
        reply = reply + rx_char
      ENDIF
    ENDIF
  ENDWHILE
  RETURN(0)
END lw_cmd

-- ------------------------------------------------------------
-- Command with result mapping + connection handling
-- 0 OK, 1 laser ERROR / empty reply, -1 comm error (connection closed),
-- -2 not connected
-- ------------------------------------------------------------
ROUTINE lw_xchg(cmd : STRING; reply : STRING) : INTEGER
VAR
  status : INTEGER
BEGIN
  IF NOT connected THEN
    RETURN(-2)
  ENDIF
  last_cmd = SUB_STR(cmd, 1, 60)
  last_reply = ''
  status = lw_cmd(cmd, reply)
  last_reply = SUB_STR(reply, 1, 120)
  IF status <> 0 THEN
    -- connection lost: report and set the flags BEFORE closing the
    -- socket - CLOSE FILE / MSG_DISCO may take long when the laser
    -- is switched off
    detail_code = status
    connected = FALSE
    WRITE TPERROR('LW: connection lost, status ', status::1, CR)
    outputs_disconnected            -- F[865] = 0, error code = 200
    no_conn_shown = TRUE            -- main loop does not report again
    retry_count = reconnect_ms DIV poll_ms
    lw_close
    RETURN(-1)
  ENDIF
  IF STR_LEN(reply) = 0 THEN
    RETURN(1)
  ENDIF
  IF INDEX(reply, 'ERROR') > 0 THEN
    RETURN(1)
  ENDIF
  RETURN(0)
END lw_xchg

-- ------------------------------------------------------------
-- Value part after "CMD: "
-- ------------------------------------------------------------
ROUTINE lw_value(reply : STRING; value : STRING)
VAR
  colon_pos : INTEGER
BEGIN
  value = ''
  colon_pos = INDEX(reply, ': ')
  IF colon_pos > 0 THEN
    value = SUB_STR(reply, colon_pos + 2, STR_LEN(reply) - colon_pos - 1)
  ENDIF
END lw_value

-- ------------------------------------------------------------
-- GET command returning one integer (-4 = reply not numeric)
-- ------------------------------------------------------------
ROUTINE lw_get_int(cmd : STRING; out_value : INTEGER) : INTEGER
VAR
  rc, parsed : INTEGER
  reply_buf : STRING[254]
  value_text   : STRING[40]
BEGIN
  rc = lw_xchg(cmd, reply_buf)
  IF rc = 0 THEN
    lw_value(reply_buf, value_text)
    CNV_STR_INT(value_text, parsed)
    IF UNINIT(parsed) THEN
      rc = -4
    ELSE
      out_value = parsed
    ENDIF
  ENDIF
  RETURN(rc)
END lw_get_int

-- ------------------------------------------------------------
-- GET command returning one real (-4 = reply not numeric)
-- ------------------------------------------------------------
ROUTINE lw_get_real(cmd : STRING; out_value : REAL) : INTEGER
VAR
  rc   : INTEGER
  parsed   : REAL
  reply_buf : STRING[254]
  value_text   : STRING[40]
BEGIN
  rc = lw_xchg(cmd, reply_buf)
  IF rc = 0 THEN
    lw_value(reply_buf, value_text)
    CNV_STR_REAL(value_text, parsed)
    IF UNINIT(parsed) THEN
      rc = -4
    ELSE
      out_value = parsed
    ENDIF
  ENDIF
  RETURN(rc)
END lw_get_real

-- ------------------------------------------------------------
-- GET command returning one unsigned 32-bit decimal value (e.g. STA).
-- Parsed digit by digit into two 16-bit halves, so the full U32 range
-- 0..4294967295 works without INTEGER overflow.
-- Returns 0 OK, -4 reply not a decimal number, or lw_xchg result.
-- ------------------------------------------------------------
ROUTINE lw_get_u32(cmd : STRING; lo_out : INTEGER; hi_out : INTEGER) : INTEGER
VAR
  rc, pos, code, carry, lo, hi, digits : INTEGER
  reply_buf  : STRING[254]
  value_text : STRING[40]
BEGIN
  rc = lw_xchg(cmd, reply_buf)
  IF rc <> 0 THEN
    RETURN(rc)
  ENDIF
  lw_value(reply_buf, value_text)
  lo = 0
  hi = 0
  digits = 0
  FOR pos = 1 TO STR_LEN(value_text) DO
    code = ORD(value_text, pos)
    IF (code >= 48) AND (code <= 57) THEN       -- '0'..'9'
      lo = lo * 10 + (code - 48)
      carry = lo DIV 65536
      lo = lo MOD 65536
      hi = hi * 10 + carry
      IF hi > 65535 THEN
        RETURN(-4)                              -- more than 32 bits
      ENDIF
      digits = digits + 1
    ELSE
      IF code <> 32 THEN                        -- spaces are ignored
        RETURN(-4)                              -- hex, sign or text
      ENDIF
    ENDIF
  ENDFOR
  IF digits = 0 THEN
    RETURN(-4)
  ENDIF
  lo_out = lo
  hi_out = hi
  RETURN(0)
END lw_get_u32

-- ------------------------------------------------------------
-- SET command with integer argument
-- ------------------------------------------------------------
ROUTINE lw_set_int(cmd : STRING; arg_value : INTEGER) : INTEGER
VAR
  num_text : STRING[16]
  reply_buf : STRING[254]
BEGIN
  int_str(arg_value, num_text)
  RETURN(lw_xchg(cmd + ' ' + num_text, reply_buf))
END lw_set_int

-- ------------------------------------------------------------
-- SET command with real argument
-- ------------------------------------------------------------
ROUTINE lw_set_real(cmd : STRING; arg_value : REAL) : INTEGER
VAR
  num_text : STRING[24]
  reply_buf : STRING[254]
BEGIN
  real_str(arg_value, num_text)
  RETURN(lw_xchg(cmd + ' ' + num_text, reply_buf))
END lw_set_real

-- ------------------------------------------------------------
-- SET command with real argument and save = 1 (IPG 2.25 / 2.27:
-- "If the user provides a value of 1 for the save argument, the
--  system will preserve the given value in non-volatile memory")
-- e.g. "SPREF 0.100 1"
-- ------------------------------------------------------------
ROUTINE lw_set_real_save(cmd : STRING; arg_value : REAL) : INTEGER
VAR
  num_text : STRING[24]
  reply_buf : STRING[254]
BEGIN
  real_str(arg_value, num_text)
  RETURN(lw_xchg(cmd + ' ' + num_text + ' 1', reply_buf))
END lw_set_real_save

-- ------------------------------------------------------------
-- Read a register as INTEGER (real registers are rounded)
-- Returns the GET_REG status
-- ------------------------------------------------------------
ROUTINE get_reg_int(reg_no : INTEGER; value_out : INTEGER) : INTEGER
VAR
  is_real  : BOOLEAN
  int_val  : INTEGER
  real_val : REAL
  stat     : INTEGER
BEGIN
  GET_REG(reg_no, is_real, int_val, real_val, stat)
  IF stat = 0 THEN
    IF is_real THEN
      value_out = ROUND(real_val)
    ELSE
      value_out = int_val
    ENDIF
  ENDIF
  RETURN(stat)
END get_reg_int

-- ------------------------------------------------------------
-- TRUE when R[35] = 1 (stop request)
-- ------------------------------------------------------------
ROUTINE stop_requested : BOOLEAN
VAR
  stop_val : INTEGER
BEGIN
  IF get_reg_int(reg_stop, stop_val) <> 0 THEN
    RETURN(FALSE)
  ENDIF
  RETURN(stop_val = 1)
END stop_requested

-- ============================================================
-- I/O helpers
-- ============================================================

-- ------------------------------------------------------------
-- Read n_bits consecutive flags F[first_flag..] as an unsigned
-- integer (first flag = LSB), port type io_flag.
-- Returns 0 or the GET_PORT_VAL status.
-- ------------------------------------------------------------
ROUTINE read_group(first_flag : INTEGER; n_bits : INTEGER; value_out : INTEGER) : INTEGER
VAR
  bit_no, bit_val, bit_mask, sum, stat : INTEGER
BEGIN
  sum = 0
  bit_mask = 1
  FOR bit_no = 0 TO n_bits - 1 DO
    GET_PORT_VAL(io_flag, first_flag + bit_no, bit_val, stat)
    IF stat <> 0 THEN
      RETURN(stat)
    ENDIF
    IF bit_val <> 0 THEN
      sum = sum + bit_mask
    ENDIF
    bit_mask = bit_mask * 2
  ENDFOR
  value_out = sum
  RETURN(0)
END read_group


-- ------------------------------------------------------------
-- Limit a value to the 16-bit unsigned range of a DO group
-- ------------------------------------------------------------
ROUTINE clamp16(value : INTEGER) : INTEGER
BEGIN
  IF value < 0 THEN
    RETURN(0)
  ENDIF
  IF value > 65535 THEN
    RETURN(65535)
  ENDIF
  RETURN(value)
END clamp16

-- ------------------------------------------------------------
-- Real laser value -> 16-bit DO value using a scale
-- ------------------------------------------------------------
ROUTINE scale_out(value : REAL; scale : REAL) : INTEGER
BEGIN
  RETURN(clamp16(ROUND(value / scale)))
END scale_out

-- ============================================================
-- Alarm handling
-- ============================================================

-- ------------------------------------------------------------
-- The STA alarm word is an unsigned 32-bit value (IPG 2.10).
-- A KAREL INTEGER is signed (-2147483648 .. +2147483646, A.10.15),
-- so the word is kept as two 16-bit halves:
--   sta_lo = bits 0..15,  sta_hi = bits 16..31
-- ------------------------------------------------------------

-- TRUE when bit bit_no (0..31) is set in the word lo/hi
ROUTINE u32_bit(lo : INTEGER; hi : INTEGER; bit_no : INTEGER) : BOOLEAN
VAR
  bit_mask, n : INTEGER
BEGIN
  bit_mask = 1
  IF bit_no < 16 THEN
    FOR n = 1 TO bit_no DO
      bit_mask = bit_mask * 2
    ENDFOR
    RETURN((lo AND bit_mask) <> 0)
  ENDIF
  FOR n = 1 TO bit_no - 16 DO
    bit_mask = bit_mask * 2
  ENDFOR
  RETURN((hi AND bit_mask) <> 0)
END u32_bit

-- Lowest active bit number of the alarm word, 0 if no bit is set.
-- Bit 0 is RESERVED in the STA table, so 0 can safely mean "none".
ROUTINE alarm_bit(lo : INTEGER; hi : INTEGER) : INTEGER
VAR
  bit_no : INTEGER
BEGIN
  IF (lo = 0) AND (hi = 0) THEN
    RETURN(0)
  ENDIF
  FOR bit_no = 0 TO 31 DO
    IF u32_bit(lo, hi, bit_no) THEN
      RETURN(bit_no)
    ENDIF
  ENDFOR
  RETURN(0)
END alarm_bit


-- ------------------------------------------------------------
-- STW warning word (U8, IPG 2.11)
-- ------------------------------------------------------------
-- Lowest active bit (0..7) of the warning word, -1 if no bit is set
ROUTINE warn_bit(warn_word : INTEGER) : INTEGER
VAR
  bit_no, bit_mask : INTEGER
BEGIN
  bit_mask = 1
  FOR bit_no = 0 TO 7 DO
    IF (warn_word AND bit_mask) <> 0 THEN
      RETURN(bit_no)
    ENDIF
    bit_mask = bit_mask * 2
  ENDFOR
  RETURN(-1)
END warn_bit

-- ============================================================
-- Laser -> flags OUT
-- ============================================================


-- ------------------------------------------------------------
-- RPROG: check that the laser runs USER program X, index prog_index.
-- Reply format (IPG 2.18): "RPROG: <program char> <index>".
-- If the laser runs something else (e.g. changed on the front panel)
-- sprog_ok is cleared -> ensure_prog sends SPROG and all values again.
-- ------------------------------------------------------------
ROUTINE check_prog
VAR
  rc         : INTEGER
  reply_buf  : STRING[254]
  value_text : STRING[40]
  prog_char  : STRING[1]
  idx_text   : STRING[8]
  prog_idx   : INTEGER
BEGIN
  IF NOT sprog_ok THEN
    RETURN                          -- SPROG not accepted yet, ensure_prog handles it
  ENDIF
  rc = lw_xchg('RPROG', reply_buf)
  IF rc <> 0 THEN
    RETURN
  ENDIF
  lw_value(reply_buf, value_text)   -- e.g. "X 0"
  IF STR_LEN(value_text) < 3 THEN
    RETURN
  ENDIF
  prog_char = SUB_STR(value_text, 1, 1)
  idx_text = SUB_STR(value_text, 3, STR_LEN(value_text) - 2)
  CNV_STR_INT(idx_text, prog_idx)
  IF UNINIT(prog_idx) THEN
    RETURN
  ENDIF
  IF ((prog_char <> 'X') AND (prog_char <> 'x')) OR (prog_idx <> prog_index) THEN
    WRITE TPERROR('LW: laser runs ', value_text, ', SPROG again', CR)
    sprog_ok = FALSE
    sprog_retry = 0
  ENDIF
END check_prog

-- ------------------------------------------------------------
-- Fixed parameters SPREF / SPOSTF / SRMPU / SRMPD.
-- One parameter per call (round robin): read it back (RPREF, RPOSTF,
-- RRMPU, RRMPD) and send the constant again when the laser value
-- differs. A refused SET is reported once and repeated only after
-- cst_retry_ms. A read that the laser refuses (e.g. RRMPU in a preset
-- program) is skipped.
-- ------------------------------------------------------------
ROUTINE check_const
VAR
  rc, int_val : INTEGER
  real_val    : REAL
  set_sent    : BOOLEAN
  par_name    : STRING[8]
BEGIN
  cst_idx = cst_idx + 1
  IF cst_idx > n_cst THEN
    cst_idx = 1
  ENDIF
  IF cst_wait[cst_idx] > 0 THEN
    cst_wait[cst_idx] = cst_wait[cst_idx] - 1
    RETURN
  ENDIF

  set_sent = FALSE
  rc = 0
  SELECT cst_idx OF
    CASE (1):
      par_name = 'SPREF'
      IF lw_get_real('RPREF', real_val) = 0 THEN
        IF ABS(real_val - pref_s) > cst_tol THEN
          rc = lw_set_real_save('SPREF', pref_s)     -- saved in the laser
          set_sent = TRUE
        ENDIF
      ENDIF
    CASE (2):
      par_name = 'SPOSTF'
      IF lw_get_real('RPOSTF', real_val) = 0 THEN
        IF ABS(real_val - postf_s) > cst_tol THEN
          rc = lw_set_real_save('SPOSTF', postf_s)   -- saved in the laser
          set_sent = TRUE
        ENDIF
      ENDIF
    CASE (3):
      par_name = 'SRMPU'
      IF lw_get_int('RRMPU', int_val) = 0 THEN
        IF int_val <> rmpu_ms THEN
          rc = lw_set_int('SRMPU', rmpu_ms)
          set_sent = TRUE
        ENDIF
      ENDIF
    CASE (4):
      par_name = 'SRMPD'
      IF lw_get_int('RRMPD', int_val) = 0 THEN
        IF int_val <> rmpd_ms THEN
          rc = lw_set_int('SRMPD', rmpd_ms)
          set_sent = TRUE
        ENDIF
      ENDIF
    ELSE:
  ENDSELECT

  IF NOT connected THEN
    RETURN                          -- comm error, handled by lw_xchg
  ENDIF
  IF set_sent THEN
    IF rc = 0 THEN
      cst_err_shown[cst_idx] = FALSE
    ELSE
      cst_wait[cst_idx] = cst_retry_ms DIV (poll_ms * n_cst)
      IF NOT cst_err_shown[cst_idx] THEN
        WRITE TPERROR('LW ', par_name, ': ', last_reply, CR)
        cst_err_shown[cst_idx] = TRUE
      ENDIF
    ENDIF
  ENDIF
END check_const

-- ------------------------------------------------------------
-- Read the laser state and write it to the DO.
-- A comm error closes the connection (lw_xchg) and ends the pass.
-- A laser ERROR reply (e.g. RWLEN in a preset program) keeps
-- the last DO value.
-- ------------------------------------------------------------
ROUTINE poll_status
VAR
  rc      : INTEGER
  int_val : INTEGER
  real_val : REAL
  sta_lo  : INTEGER
  sta_hi  : INTEGER
  warn_no : INTEGER
BEGIN
  -- RPROG: laser must run USER program X, index prog_index
  check_prog
  IF NOT connected THEN
    RETURN
  ENDIF

  -- STA: U32 alarm word -> IPG No Error flag, Error code
  -- (alarms / warnings are not shown on the TP - another system
  --  function displays them from the error code)
  -- STW: U8 warning word, only evaluated when no STA alarm is active
  rc = lw_get_u32('STA', sta_lo, sta_hi)
  IF rc = 0 THEN
    sta_bad_shown = FALSE
    -- F[865] inverted: 1 = no alarm, 0 = alarm active
    IF (sta_lo <> 0) OR (sta_hi <> 0) THEN
      write_group(out_error, fo_error, 1, 0)
    ELSE
      write_group(out_error, fo_error, 1, 1)
    ENDIF
    IF (sta_lo <> 0) OR (sta_hi <> 0) THEN
      -- alarm active: error code = first active STA bit
      write_group(out_errcode, fo_errcode, 16, alarm_bit(sta_lo, sta_hi))
    ELSE
      -- no alarm: check the warnings (STW), same method
      rc = lw_get_int('STW', int_val)
      IF rc = 0 THEN
        warn_no = warn_bit(int_val)
        IF warn_no < 0 THEN
          write_group(out_errcode, fo_errcode, 16, 0)
        ELSE
          write_group(out_errcode, fo_errcode, 16, warn_ofs + warn_no)
        ENDIF
      ENDIF
    ENDIF
  ELSE
    IF (rc = -4) AND (NOT sta_bad_shown) THEN
      WRITE TPERROR('LW STA bad reply: ', last_reply, CR)
      sta_bad_shown = TRUE
    ENDIF
  ENDIF
  IF NOT connected THEN
    RETURN
  ENDIF

  -- STG: general status, bit 2 = Emission ON
  rc = lw_get_int('STG', int_val)
  IF rc = 0 THEN
    IF (int_val AND 4) <> 0 THEN
      write_group(out_emis, fo_emission, 1, 1)
    ELSE
      write_group(out_emis, fo_emission, 1, 0)
    ENDIF
  ENDIF
  IF NOT connected THEN
    RETURN
  ENDIF

  -- RPURGE: purge gas enable (IPG 2.32) -> F[868]
  rc = lw_get_int('RPURGE', int_val)
  IF rc = 0 THEN
    IF int_val = 1 THEN
      write_group(out_purge, fo_purge, 1, 1)
    ELSE
      write_group(out_purge, fo_purge, 1, 0)
    ENDIF
  ENDIF
  IF NOT connected THEN
    RETURN
  ENDIF

  -- RPOW: power setpoint [W]
  rc = lw_get_int('RPOW', int_val)
  IF rc = 0 THEN
    real_val = int_val                  -- explicit INTEGER -> REAL
    write_group(out_power, fo_power, 16, scale_out(real_val, power_scale))
  ENDIF
  IF NOT connected THEN
    RETURN
  ENDIF

  -- RWFREQ: wobble frequency [Hz] (user programs only)
  rc = lw_get_real('RWFREQ', real_val)
  IF rc = 0 THEN
    write_group(out_wfreq, fo_wfreq, 16, scale_out(real_val, wfreq_scale))
  ENDIF
  IF NOT connected THEN
    RETURN
  ENDIF

  -- RWLEN: wobble length [mm] (user programs only)
  rc = lw_get_real('RWLEN', real_val)
  IF rc = 0 THEN
    write_group(out_wlen, fo_wlen, 16, scale_out(real_val, wlen_scale))
  ENDIF
  IF NOT connected THEN
    RETURN
  ENDIF

  -- fixed parameters SPREF / SPOSTF / SRMPU / SRMPD, one per cycle
  check_const
END poll_status

-- ============================================================
-- Flags IN -> laser
-- ============================================================

-- ------------------------------------------------------------
-- Send one input channel to the laser. Returns lw_xchg result.
-- ------------------------------------------------------------
ROUTINE send_input(in_idx : INTEGER; raw : INTEGER) : INTEGER
BEGIN
  SELECT in_idx OF
    CASE (in_mat):
      RETURN(lw_set_int('SMAT', raw))         -- raw is already 0 / 1
    CASE (in_power):
      RETURN(lw_set_int('SPOW', ROUND(raw * power_scale)))
    CASE (in_wfreq):
      RETURN(lw_set_real('SWFREQ', raw * wfreq_scale))
    CASE (in_wlen):
      RETURN(lw_set_real('SWLEN', raw * wlen_scale))
    CASE (in_comp):
      RETURN(lw_set_real('SPCF', raw * comp_scale))
    ELSE:
      RETURN(-3)
  ENDSELECT
  RETURN(-3)
END send_input

-- ------------------------------------------------------------
-- Make sure the laser runs USER program X, index prog_index.
-- On success all values are sent again (index settings belong to
-- the active index). A refused SPROG is reported and retried
-- every sprog_retry_ms.
-- ------------------------------------------------------------
ROUTINE ensure_prog
VAR
  rc, idx   : INTEGER
  num_text  : STRING[8]
  reply_buf : STRING[254]
BEGIN
  IF sprog_ok THEN
    RETURN
  ENDIF
  IF sprog_retry > 0 THEN
    sprog_retry = sprog_retry - 1
    RETURN
  ENDIF
  int_str(prog_index, num_text)
  rc = lw_xchg('SPROG X ' + num_text, reply_buf)
  IF NOT connected THEN
    RETURN                          -- comm error, retried after reconnect
  ENDIF
  IF rc = 0 THEN
    sprog_ok = TRUE
    FOR idx = 1 TO n_in DO
      in_sent[idx] = -1
    ENDFOR
  ELSE
    sprog_retry = sprog_retry_ms DIV poll_ms
    IF STR_LEN(last_reply) > 0 THEN
      WRITE TPERROR('LW ', last_reply, CR)
    ELSE
      WRITE TPERROR('LW: SPROG X ', num_text, ' failed, rc ', rc::1, CR)
    ENDIF
  ENDIF
END ensure_prog

-- ------------------------------------------------------------
-- Read all input groups; send a value when it changed and is
-- stable for 2 scans. A failed SET is reported once and not
-- repeated until the flag value changes again.
-- ------------------------------------------------------------
ROUTINE process_inputs
VAR
  in_idx, raw, stat, rc : INTEGER
BEGIN
  ensure_prog                          -- SPROG X 0 first
  IF NOT connected THEN
    RETURN
  ENDIF
  FOR in_idx = 1 TO n_in DO
    stat = read_group(in_port[in_idx], in_bits[in_idx], raw)
    IF (stat = 0) AND (in_idx = in_mat) THEN
      raw = raw MOD 2                  -- only even / odd matters
    ENDIF
    IF stat <> 0 THEN
      IF NOT in_err_shown[in_idx] THEN
        WRITE TPERROR('LW: F[', in_port[in_idx]::1, '] read status ', stat::1, CR)
        in_err_shown[in_idx] = TRUE
      ENDIF
    ELSE
      IF (raw = in_prev[in_idx]) AND (raw <> in_sent[in_idx]) THEN
        rc = send_input(in_idx, raw)
        IF NOT connected THEN
          RETURN                       -- comm error, value is sent again after reconnect
        ENDIF
        in_sent[in_idx] = raw
        IF rc <> 0 THEN
          -- message line: laser reply text, USER screen: full detail
          IF STR_LEN(last_reply) > 0 THEN
            WRITE TPERROR('LW ', last_reply, CR)
          ELSE
            WRITE TPERROR('LW: set ch ', in_idx::1, ' = ', raw::1, ' failed, rc ', rc::1, CR)
          ENDIF
          WRITE TPDISPLAY('LW set ch ', in_idx::1, ' = ', raw::1, ' rc ', rc::1, CR)
          WRITE TPDISPLAY(' sent:  ', last_cmd, CR)
          WRITE TPDISPLAY(' reply: ', last_reply, CR)
        ELSE
          in_err_shown[in_idx] = FALSE
        ENDIF
      ENDIF
      in_prev[in_idx] = raw
    ENDIF
  ENDFOR
END process_inputs

-- ------------------------------------------------------------
-- Nozzle (F[707]): prepared only, NOT used.
-- The LightWELD Command Interface (R0.5) has no TCP command for it -
-- it is a hardware input of the laser. Its state can be read back
-- from STI bit 0 (Nozzle OK).
-- ------------------------------------------------------------

-- ------------------------------------------------------------
-- Error reset: F[708] rising edge (0 -> 1) sends RERR (IPG 2.16).
-- RERR clears only alarms whose cause is gone; alarms marked
-- "Clearable = NO" in the STA table need a power cycle of the laser.
-- The result is visible on F[865] / F[929-944] after the next poll.
-- An edge while the laser is not connected is ignored.
-- Nothing is displayed on the TP.
-- ------------------------------------------------------------
ROUTINE check_reset
VAR
  bit_val, stat, rc : INTEGER
  reply_buf : STRING[254]
BEGIN
  GET_PORT_VAL(io_flag, fi_reset, bit_val, stat)
  IF stat <> 0 THEN
    RETURN                          -- flag not readable, try again next cycle
  ENDIF
  IF (bit_val <> 0) AND (rst_last = 0) AND connected THEN
    rc = lw_xchg('RERR', reply_buf) -- result not displayed
  ENDIF
  rst_last = bit_val
END check_reset

-- ------------------------------------------------------------
-- Controller ready check: no connection attempt until the system
-- variable $PWRUP_DELAY.$SY_READY is TRUE (power-up finished).
-- Read with GET_VAR (A.8.31), prog_name '*SYSTEM*'. Once TRUE the
-- result is kept, the variable is not read again.
-- ------------------------------------------------------------
ROUTINE check_sys_ready
VAR
  stat : INTEGER
BEGIN
  IF sys_ready THEN
    RETURN
  ENDIF
  GET_VAR(sys_rdy_entry, '*SYSTEM*', '$PWRUP_DELAY.$SY_READY', sys_rdy_val, stat)
  IF stat <> 0 THEN
    IF NOT sys_rdy_err THEN
      WRITE TPERROR('LW: $PWRUP_DELAY.$SY_READY status ', stat::1, CR)
      POST_ERR(stat, '', 0, 0)      -- system text as WARNING
      sys_rdy_err = TRUE
    ENDIF
    RETURN
  ENDIF
  IF sys_rdy_val THEN
    sys_ready = TRUE
    WRITE TPERROR('LW: system ready, connecting', CR)
  ENDIF
END check_sys_ready

-- ------------------------------------------------------------
-- Force every input to be sent again (after a (re)connect)
-- ------------------------------------------------------------
ROUTINE resend_all
VAR
  idx : INTEGER
BEGIN
  FOR idx = 1 TO n_in DO
    in_sent[idx] = -1
  ENDFOR
  sta_bad_shown = FALSE
  sprog_ok = FALSE
  sprog_retry = 0
  FOR idx = 1 TO n_cst DO
    cst_wait[idx] = 0               -- check all fixed parameters again
  ENDFOR
END resend_all

-- ============================================================
-- MAIN: background loop
-- ============================================================
BEGIN
  client_tag = 'C3:'
  connected = FALSE
  file_open = FALSE
  stop_req = FALSE
  retry_count = 0
  sys_ready = FALSE
  sys_rdy_entry = 0
  sys_rdy_err = FALSE
  no_conn_shown = FALSE
  laser_host = 'IPG'               -- name in the Host Name table
  detail_code = 0
  sta_bad_shown = FALSE
  sprog_ok = FALSE
  sprog_retry = 0
  trig_src[1] = trig1_src
  trig_do[1]  = do_trig1
  trig_src[2] = trig2_src
  trig_do[2]  = do_trig2
  FOR init_idx = 1 TO 2 DO
    trig_last[init_idx] = -1
    trig_err[init_idx] = FALSE
  ENDFOR
  rst_last = -1                     -- no reset if F[708] is already ON at start

  cst_idx = 0
  FOR init_idx = 1 TO n_cst DO
    cst_wait[init_idx] = 0
    cst_err_shown[init_idx] = FALSE
  ENDFOR

  in_port[in_mat]   = fi_psel
  in_bits[in_mat]   = 3
  in_port[in_power] = fi_power
  in_bits[in_power] = 16
  in_port[in_wfreq] = fi_wfreq
  in_bits[in_wfreq] = 16
  in_port[in_wlen]  = fi_wlen
  in_bits[in_wlen]  = 16
  in_port[in_comp]  = fi_comp
  in_bits[in_comp]  = 16

  FOR init_idx = 1 TO n_in DO
    in_prev[init_idx] = -1
    in_sent[init_idx] = -1
    in_err_shown[init_idx] = FALSE
  ENDFOR
  FOR init_idx = 1 TO n_out DO
    out_last[init_idx] = -1
    out_err_shown[init_idx] = FALSE
  ENDFOR

  -- a previous instance may have left the tag connected
  MSG_DISCO(client_tag, karel_stat)
  -- no outputs_disconnected here: the error code 200 is written only
  -- when the first connection attempt really fails (main loop)

  WRITE TPERROR('LW: started, waiting for $PWRUP_DELAY.$SY_READY', CR)

  WHILE NOT stop_req DO
    trig_mirror                     -- triggers work with or without laser connection

    -- automatic connect / reconnect, only after power-up is finished
    check_sys_ready
    IF (NOT connected) AND sys_ready THEN
      IF retry_count <= 0 THEN
        karel_stat = lw_connect
        IF karel_stat = 0 THEN
          connected = TRUE
          no_conn_shown = FALSE
          resend_all
          WRITE TPERROR('LW: connected', CR)
        ELSE
          detail_code = karel_stat
          retry_count = reconnect_ms DIV poll_ms
        ENDIF
      ELSE
        retry_count = retry_count - 1
      ENDIF
    ENDIF

    check_reset                     -- F[708] rising edge -> RERR
    IF connected THEN
      process_inputs
    ENDIF
    IF connected THEN
      poll_status
    ENDIF
    IF NOT connected THEN
      IF sys_ready AND (NOT no_conn_shown) THEN
        WRITE TPERROR('LW: no connection, status ', detail_code::1, CR)
        IF detail_code > 0 THEN
          -- show the system text of the status (e.g. 67176 = HOST-176)
          -- in the alarm line / history as WARNING (A.17.14 POST_ERR)
          POST_ERR(detail_code, '', 0, 0)
        ENDIF
        no_conn_shown = TRUE
        retry_count = reconnect_ms DIV poll_ms
      ENDIF
      outputs_disconnected
    ENDIF

    DELAY poll_ms
    stop_req = stop_requested
  ENDWHILE

  lw_close
  outputs_disconnected
  trig_off
END lightweld
